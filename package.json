{
  "name": "cubegin-core-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build-web.mjs",
    "check": "tsc -p sdk/web/tsconfig.json --noEmit && tsc -p examples/web/tsconfig.json",
    "test": "node --test sdk/web/test/*.test.mjs",
    "test:e2e": "playwright test",
    "dev": "vite examples/web --host 127.0.0.1 --port 4488 --strictPort"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  }
}
